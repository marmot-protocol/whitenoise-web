{
    "name": "whitenoise-web",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "dev": "vite dev --host 0.0.0.0",
        "build": "vite build && node scripts/markdown-routing.mjs",
        "preview": "vite preview --host 0.0.0.0",
        "prepare": "svelte-kit sync",
        "ci": "bun run docs:check && biome ci . && bun run test && bun run check && bun run build && bun run test:deployment",
        "lint": "biome check",
        "lint:write": "biome check --write",
        "format": "biome format --write",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "test": "vitest run",
        "test:deployment": "node --no-experimental-require-module scripts/smoke-vercel.mjs",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "canary:publish": "./scripts/publish-canary.sh",
        "tokens:generate": "bun scripts/generate-tokens.ts",
        "artwork:measure": "${ARTWORK_PYTHON:-python3} scripts/measure-artwork.py",
        "docs:check": "node scripts/check-documentation.mjs"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.2",
        "@sveltejs/adapter-vercel": "^6.3.4",
        "@sveltejs/kit": "^2.70.3",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^22.20.5",
        "@types/sanitize-html": "^2.16.2",
        "@vitest/coverage-v8": "5.0.5",
        "carbon-icons-svelte": "^13.17.0",
        "svelte": "^5.57.2",
        "svelte-check": "^4.7.7",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "vite": "^8.3.5",
        "vitest": "^5.0.5",
        "@types/turndown": "^5.0.6"
    },
    "dependencies": {
        "@fontsource-variable/manrope": "^5.3.0",
        "applesauce-core": "^7.0.3",
        "applesauce-relay": "^7.0.0",
        "marked": "^18.1.1",
        "nostr-tools": "^2.25.2",
        "rxjs": "^7.8.2",
        "sanitize-html": "^2.18.1",
        "turndown": "^7.2.4",
        "turndown-plugin-gfm": "^1.0.2"
    },
    "packageManager": "bun@1.4.2",
    "engines": {
        "node": ">=22.12.0 <23",
        "bun": ">=1.4.2"
    },
    "overrides": {
        "cookie": "^0.7.2",
        "devalue": "^5.9.3",
        "source-map-js": "^1.2.2"
    }
}
