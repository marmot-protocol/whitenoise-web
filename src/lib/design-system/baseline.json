{
    "background": {
        "#fff": ["body", ".site-header", ".download-closing .wn-button"],
        "var(--paper)": [".wn-site"],
        "var(--ink)": [".wn-button"],
        "#3d3d3d": [".wn-button:hover"],
        "#f0f0ef": [".wn-button.secondary"],
        "#e3e3e1": [".wn-button.secondary:hover"],
        "#f2f2f2": [".supporters", ".donation-methods", ".canary-latest"],
        "#111": [".download-closing,\n.site-footer", ".skip-link"],
        "#ddd": [".download-closing .wn-button:hover"],
        "transparent": [".donation-address button"],
        "#f2f2ef": [".technical-content pre", ".wn-site .prose pre"]
    },
    "color": {
        "var(--ink)": [".wn-site", ".donation-label", ".donation-address button:hover"],
        "#111": [
            ".site-header",
            ".wn-button.secondary",
            ".supporters",
            ".download-closing .wn-button",
            ".article-aside a:hover",
            ".wn-site .prose h1",
            ".wn-site .prose h2"
        ],
        "#9e9e9e": [".hero-tagline"],
        "white": [".wn-button"],
        "var(--muted)": [
            ".small-note",
            ".feature-copy p",
            ".faq-items details p",
            ".muted",
            ".page-description",
            ".download-option p",
            ".download-help p",
            ".article-body p",
            ".article-aside",
            ".contribution-list p",
            ".donation-intro p",
            ".donation-address-text",
            ".donation-address button",
            ".blog-entry p",
            ".blog-entry time",
            ".empty-blog p",
            ".legal-policy :is(ul, ol)",
            ".article-summary"
        ],
        "#686868": [".text-link:hover"],
        "#5d5d5d": [".supporters > p"],
        "#fff": [".download-closing,\n.site-footer", ".skip-link"],
        "#aaa": [".footer-bottom"],
        "#222": [".technical-content pre"],
        "#757575": [".canary-attestation .text-link"],
        "#444": [".wn-site .prose"]
    },
    "margin": {
        "0": [".wn-site :where(h1, h2, h3, p, figure)"],
        "0 0 45px": [".wn-site .prose h1"],
        "50px 0 22px": [".wn-site .prose h2"],
        "30px 0 15px": [".wn-site .prose h3"],
        "0 auto": [".article-aside .artwork"]
    },
    "gap": {
        "30px": [".desktop-nav", ".download-help"],
        "32px": [".hero-identity", ".wn-button", ".contribute-hero"],
        "12px": [
            ".hero-action",
            ".download-option .wn-button",
            ".donation-address",
            ".hero-action"
        ],
        "72px": [".illustrated"],
        "54px": [".supporters > div"],
        "80px": [".faq-section", ".download-help", ".article-layout"],
        "24px": [".faq-items summary", ".download-options", ".supporters > div", ".blog-entry"],
        "64px": [".contribute-hero"],
        "40px": [".download-options", ".illustrated", ".article-layout", ".contribution-list"],
        "12px 32px": [".privacy-resources"],
        "14px": [".article-aside nav"],
        "55px 80px": [".contribution-list"],
        "48px 80px": [".donation-methods"],
        "20px": [".donation-controls"],
        "60px": [".blog-entry"],
        "28px": [".canary-attestations", ".hero-identity", ".illustrated"],
        "8px 24px": [".canary-attestation"],
        "45px": [".faq-section"],
        "10px": [".menu-toggle"],
        "2rem": [".illustrated:has(.artwork.normalized)"],
        "42px": [".download-options"],
        "25px": [".article-layout"],
        "16px": [".donation-controls"],
        "36px": [".donation-methods"]
    },
    "font-size": {
        "15px": [".desktop-nav a", ".wn-button", ".text-link"],
        "clamp(40px, 5.2vw, 72px)": [".hero-title"],
        "inherit": [".home-hero h1", ".hero-tagline"],
        "13px": [".small-note", ".eyebrow", ".article-aside", ".blog-entry time"],
        "clamp(32px, 4vw, 50px)": [".feature-block h2,\n.faq-section h2"],
        "19px": [".feature-copy p", ".mobile-nav a"],
        "18px": [
            ".supporters > p",
            ".download-help p",
            ".article-body p",
            ".donation-intro p",
            ".legal-policy :is(ul, ol)",
            ".canary-attestation h3",
            ".wn-site .prose",
            ".feature-copy p",
            ".page-description"
        ],
        "17px": [
            ".faq-items summary",
            ".contribution-list p",
            ".blog-entry p",
            ".feature-copy p",
            ".legal-policy :is(ul, ol)",
            ".article-body p",
            ".wn-site .prose"
        ],
        "16px": [
            ".faq-items details p",
            ".download-option p",
            ".donation-address-text",
            ".canary-attestation .text-link",
            ".faq-items summary"
        ],
        "clamp(40px, 6.5vw, 78px)": [".download-closing h2"],
        "12px": [".footer-bottom"],
        "clamp(44px, 6.7vw, 88px)": [".page-intro h1,\n.legal-policy h1"],
        "21px": [".page-description"],
        "30px": [
            ".download-option h2",
            ".contribution-list h2",
            ".empty-blog h2",
            ".article-body h2"
        ],
        "38px": [".download-help h2", ".article-quote", ".donation-section h2"],
        "34px": [".article-body h2", ".feature-block h2"],
        "24px": [".donation-label", ".wn-site .prose h3"],
        "32px": [
            ".blog-entry h2",
            ".technical-content h2",
            ".wn-site .prose h2",
            ".download-help h2",
            ".article-quote",
            ".donation-section h2"
        ],
        "clamp(40px, 6vw, 72px)": [".wn-site .prose h1"],
        "clamp(36px, 5vw, 64px)": [".article-heading"],
        "22px": [".article-summary"],
        "14px": [".menu-toggle", ".donation-controls .wn-button"],
        "clamp(36px, 7vw, 48px)": [".hero-title"],
        "36px": [".faq-section h2"],
        "clamp(36px, 8.5vw, 52px)": [".download-closing h2"],
        "clamp(40px, 10vw, 58px)": [".page-intro h1,\n    .legal-policy h1"],
        "27px": [".blog-entry h2"],
        "28px": [".technical-content h2"]
    },
    "font-weight": {
        "600": [
            ".desktop-nav a",
            ".hero-tagline",
            ".wn-button",
            ".faq-items summary",
            ".eyebrow",
            ".empty-blog h2",
            ".canary-attestation h3"
        ],
        "800": [".home-hero h1"],
        "700": [
            ".feature-block h2,\n.faq-section h2",
            ".download-help h2",
            ".article-body h2",
            ".contribution-list h2",
            ".donation-section h2",
            ".donation-label",
            ".wn-site .prose h2"
        ],
        "650": [
            ".text-link",
            ".download-option h2",
            ".article-quote",
            ".blog-entry h2",
            ".wn-site .prose h3"
        ],
        "750": [
            ".download-closing h2",
            ".page-intro h1,\n.legal-policy h1",
            ".wn-site .prose h1",
            ".article-heading"
        ],
        "400": [".muted"]
    },
    "padding-block": {
        "14px": [".desktop-nav a"],
        "9rem": [".home-hero"],
        "64px": [".feature-block", ".download-closing"],
        "5px": [".text-link"],
        "56px 68px": [".supporters", ".canary-latest"],
        "96px": [".download-closing"],
        "41px 32px": [".site-footer"],
        "74px 76px": ["/* Secondary pages */\n.page-intro", ".contribute-hero"],
        "64px 72px": [".donation-methods"],
        "40px": [".blog-entry"],
        "74px 100px": [".legal-policy"],
        "70px 100px": [".blog-article"],
        "5.25rem": [".home-hero"],
        "36px": [".feature-block"],
        "42px 54px": [".supporters", ".canary-latest"],
        "48px 64px": [".contribute-hero"],
        "42px 48px": [".page-intro"],
        "48px 56px": [".donation-methods"]
    },
    "line-height": {
        "1.08": [".hero-title", ".feature-block h2,\n.faq-section h2"],
        "inherit": [".home-hero h1", ".hero-tagline"],
        "1.6": [
            ".feature-copy p",
            ".download-option p",
            ".download-help p",
            ".blog-entry p",
            ".empty-blog p",
            ".article-summary"
        ],
        "1.5": [".supporters > p", ".donation-address-text", ".canary-attestation h3"],
        "1.65": [
            ".faq-items details p",
            ".contribution-list p",
            ".technical-content :is(p, li, td)"
        ],
        "1.04": [".download-closing h2", ".wn-site .prose h1"],
        "1.02": [".page-intro h1,\n.legal-policy h1"],
        "1.55": [".page-description"],
        "1.12": [".download-help h2"],
        "1.15": [".article-body h2", ".technical-content h2"],
        "1.75": [".article-body p", ".legal-policy :is(ul, ol)", ".wn-site .prose"],
        "1.2": [".article-quote", ".donation-label", ".blog-entry h2"],
        "1.7": [".donation-intro p"],
        "1.18": [".wn-site .prose h2"],
        "1.06": [".article-heading"],
        "1.1": [".hero-title"]
    },
    "letter-spacing": {
        "-0.055em": [".hero-title", ".download-closing h2"],
        "inherit": [".home-hero h1", ".hero-tagline"],
        "-0.045em": [".feature-block h2,\n.faq-section h2", ".article-heading"],
        "-0.06em": [".page-intro h1,\n.legal-policy h1"],
        "-0.035em": [
            ".download-option h2",
            ".article-body h2",
            ".contribution-list h2",
            ".donation-label",
            ".blog-entry h2",
            ".technical-content h2",
            ".wn-site .prose h2"
        ],
        "-0.04em": [".download-help h2", ".article-quote", ".donation-section h2"],
        "-0.05em": [".wn-site .prose h1", ".hero-title"]
    },
    "padding": {
        "15px 24px": [".wn-button"],
        "22px 0": [".faq-items details"],
        "14px 20px": [".skip-link"],
        "0": [".contribute-hero .page-intro"],
        "45px 0 65px": [".empty-blog"],
        "24px": [".wn-site .prose pre"],
        "0 0 20px": [".mobile-nav:not([hidden])"],
        "13px 0": [".mobile-nav a"]
    },
    "grid-template-columns": {
        "1fr 1fr": [".illustrated", ".download-help", ".contribution-list"],
        "1fr 1.1fr": [".faq-section"],
        "1.1fr 1fr": [".contribute-hero"],
        "repeat(3, minmax(0, 1fr))": [".download-options"],
        "minmax(0, 1fr) 220px": [".article-layout"],
        "repeat(2, minmax(0, 1fr))": [".donation-methods"],
        "1fr 220px": [".blog-entry"],
        "minmax(0, 1fr) 170px": [".article-layout"],
        "1fr": [
            ".contribute-hero",
            ".download-options",
            ".contribution-list",
            ".donation-methods",
            ".blog-entry"
        ]
    },
    "margin-block": {
        "18px 90px": [".download-options"],
        "15px 24px": [".download-option p"],
        "60px 100px": [".download-help"],
        "18px": [".article-body p", ".legal-policy :is(ul, ol)"],
        "25px": [".article-aside nav", ".article-heading"],
        "65px": [".article-quote"],
        "-10px": [".donation-address button"],
        "15px 100px": [".blog-list"],
        "0 18px": [".blog-entry h2"],
        "16px": [".technical-content p"],
        "20px": [".wn-site .prose p", ".wn-site .prose :is(ul, ol)"],
        "30px": [".wn-site .prose img", ".wn-site .prose blockquote"],
        "40px": [".article-image", ".article-quote"],
        "35px": [".article-summary"],
        "10px 65px": [".download-options"]
    }
}
