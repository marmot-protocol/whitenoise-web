{
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Link",
                    "value": "<https://www.whitenoise.chat/llms.txt>; rel=\"alternate\"; type=\"text/plain\"; title=\"LLM-friendly site overview\", <https://www.whitenoise.chat/llms-full.txt>; rel=\"alternate\"; type=\"text/plain\"; title=\"White Noise FAQ and guides\""
                },
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                }
            ]
        }
    ],
    "redirects": [
        {
            "source": "/:path*",
            "has": [
                {
                    "type": "host",
                    "value": "whitenoise.chat"
                }
            ],
            "destination": "https://www.whitenoise.chat/:path*",
            "permanent": true
        }
    ]
}
